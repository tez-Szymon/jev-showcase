{
  "name": "youtube-insight-filter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --import tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "dev": "node --import tsx --env-file-if-exists=.env server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.1.24",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
