{
  "name": "jev-demo",
  "version": "1.0.0",
  "description": "Local support request demo with Jev",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "format": "prettier --write src scripts tests fixtures *.ts *.mjs README.md package.json"
  },
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "@next/env": "^16.3.6",
    "@typesafe-ai/sdk": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
